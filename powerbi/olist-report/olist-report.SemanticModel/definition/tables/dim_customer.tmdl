/// SCD2 customer dimension: one row per address version.
table dim_customer
	lineageTag: 2d3323d0-cf4f-46e0-a338-860635b272c7

	column customer_sk
		dataType: string
		isHidden
		lineageTag: e580620e-d176-4c2c-be26-88492774f0dc
		summarizeBy: none
		sourceColumn: customer_sk

	column customer_unique_id
		dataType: string
		lineageTag: 96cc9e2e-8c87-4fc6-8779-a09dfeac3bbf
		summarizeBy: none
		sourceColumn: customer_unique_id

	column zip_code_prefix
		dataType: string
		lineageTag: ba4e5294-6f5d-48a4-b5c7-565f10010d47
		summarizeBy: none
		sourceColumn: zip_code_prefix

	column city
		dataType: string
		lineageTag: 0038eece-40ca-40e7-add1-e737144d5275
		summarizeBy: none
		sourceColumn: city

	column state
		dataType: string
		lineageTag: 214c6813-12c2-47bd-a387-b8b2ffba9533
		summarizeBy: none
		sourceColumn: state

	column address_effective_at
		dataType: dateTime
		formatString: yyyy-mm-dd hh:nn:ss
		lineageTag: 5d645d35-2ae2-4c8d-bc22-d0780ddceacb
		summarizeBy: none
		sourceColumn: address_effective_at

	column valid_from
		dataType: dateTime
		formatString: yyyy-mm-dd hh:nn:ss
		lineageTag: 1f93201c-d529-4bf1-bd27-d7cbb7ce0622
		summarizeBy: none
		sourceColumn: valid_from

	column valid_to
		dataType: dateTime
		formatString: yyyy-mm-dd hh:nn:ss
		lineageTag: d0428fea-754d-4f26-9fb3-21935a2fd30b
		summarizeBy: none
		sourceColumn: valid_to

	column is_current
		dataType: boolean
		lineageTag: 54623776-122e-48ff-9d5c-75f2122555c4
		summarizeBy: none
		sourceColumn: is_current

	column version_count
		dataType: int64
		formatString: #,0
		lineageTag: a65c43d3-fb10-4764-9704-0e0b333a478c
		summarizeBy: none
		sourceColumn: version_count

	partition dim_customer = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(ExportsFolder & "\dim_customer.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Headers, {"customer_sk", "customer_unique_id", "zip_code_prefix", "city", "state", "address_effective_at", "valid_from", "valid_to", "is_current", "version_count"}),
				    Blanks = Table.TransformColumns(Kept, {}, each if _ = "" then null else _),
				    Flags = Table.TransformColumns(Blanks, {{"is_current", each if _ = null then null else _ = "t", type logical}}),
				    Typed = Table.TransformColumnTypes(Flags, {{"customer_sk", type text}, {"customer_unique_id", type text}, {"zip_code_prefix", type text}, {"city", type text}, {"state", type text}, {"address_effective_at", type datetime}, {"valid_from", type datetime}, {"valid_to", type datetime}, {"version_count", Int64.Type}}, "en-US")
				in
				    Typed

