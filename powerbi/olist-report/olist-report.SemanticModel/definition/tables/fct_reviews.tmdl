	partition fct_reviews = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(ExportsFolder & "\fct_reviews.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Headers, {"review_id", "order_id", "sent_date_key", "score", "is_answered", "has_comment", "sent_at", "answered_at", "response_hours"}),
				    Blanks = Table.TransformColumns(Kept, {}, each if _ = "" then null else _),
				    Flags = Table.TransformColumns(Blanks, {{"is_answered", each if _ = null then null else _ = "t", type logical}, {"has_comment", each if _ = null then null else _ = "t", type logical}}),
				    Typed = Table.TransformColumnTypes(Flags, {{"review_id", type text}, {"order_id", type text}, {"sent_date_key", Int64.Type}, {"score", Int64.Type}, {"sent_at", type datetime}, {"answered_at", type datetime}, {"response_hours", type number}}, "en-US")
				in
				    Typed

