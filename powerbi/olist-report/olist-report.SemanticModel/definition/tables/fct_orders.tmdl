				    Blanks = Table.TransformColumns(Kept, {}, each if _ = "" then null else _),
				    Flags = Table.TransformColumns(Blanks, {{"is_delivered", each if _ = null then null else _ = "t", type logical}, {"is_late", each if _ = null then null else _ = "t", type logical}, {"is_first_order", each if _ = null then null else _ = "t", type logical}}),
				    Typed = Table.TransformColumnTypes(Flags, {{"order_id", type text}, {"customer_sk", type text}, {"customer_unique_id", type text}, {"purchase_date_key", Int64.Type}, {"order_status", type text}, {"purchased_at", type datetime}, {"approved_at", type datetime}, {"delivered_carrier_at", type datetime}, {"delivered_customer_at", type datetime}, {"estimated_delivery_date", type date}, {"item_count", Int64.Type}, {"seller_count", Int64.Type}, {"items_value", Currency.Type}, {"freight_value", Currency.Type}, {"gross_revenue", Currency.Type}, {"payment_value", Currency.Type}, {"delivery_days", type number}, {"delay_days", type number}, {"customer_order_number", Int64.Type}, {"cohort_month", type date}}, "en-US")
				in
				    Typed

