	partition dim_seller = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(ExportsFolder & "\dim_seller.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Headers, {"seller_sk", "seller_id", "zip_code_prefix", "city", "state"}),
				    Blanks = Table.TransformColumns(Kept, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"seller_sk", type text}, {"seller_id", type text}, {"zip_code_prefix", type text}, {"city", type text}, {"state", type text}}, "en-US")
				in
				    Typed

