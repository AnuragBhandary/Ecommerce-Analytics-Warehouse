		sourceColumn: seller_sk

	column seller_id
		dataType: string
		lineageTag: 205de931-60ae-442d-808d-c8db5497704b
		summarizeBy: none
		sourceColumn: seller_id

	column zip_code_prefix
		dataType: string
		lineageTag: a0a31a8f-5a10-44c6-94c2-a58f6153b566
