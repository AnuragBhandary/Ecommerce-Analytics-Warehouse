# Throwaway local-dev credentials; they match docker-compose.yml. Copy to .env to override.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=olist
MYSQL_PASSWORD=olist
MYSQL_DATABASE=olist
WAREHOUSE_DSN=postgresql://warehouse:warehouse@127.0.0.1:5433/warehouse
OLIST_DATA_DIR=data

# Metabase admin created by `make dashboards` (local only).
MB_ADMIN_EMAIL=admin@example.com
MB_ADMIN_PASSWORD=olist-local-dev-1
